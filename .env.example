PORT=3000

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
PRIVATE_KEY_PATH=./private-key.pem
GITHUB_APP_SLUG=

# AI provider: anthropic (default) | openai | gemini
AI_PROVIDER=anthropic

# Anthropic (default provider)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # optional, this is the default

# OpenAI (set AI_PROVIDER=openai to use)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o               # optional, this is the default

# Google Gemini (set AI_PROVIDER=gemini to use)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash     # optional, this is the default
