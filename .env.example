# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=my-leadbot
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Private key — choose ONE:
# Option A: Local dev (path to .pem file)
PRIVATE_KEY_PATH=./private-key.pem
# Option B: Railway/cloud (paste .pem contents as a single env var)
# PRIVATE_KEY_CONTENTS="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# AI provider — anthropic | openai | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Admin dashboard (disabled if not set)
DASHBOARD_TOKEN=choose-a-strong-random-token

# Server port (Railway sets this automatically)
PORT=3000
